# Dockerfile for The Backroom MCP Server
FROM python:3.11-slim

WORKDIR /app

# eMudhra CA incident (Oct 2026): force patched Debian ca-certificates and pip>=26.2.2 even if Render reuses a cached base layer
RUN apt-get update && apt-get install -y --no-install-recommends --only-upgrade ca-certificates && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir --upgrade "pip>=26.2.2"

# Install dependencies (pinned: an unpinned rebuild on 2026-09-11 jumped fastmcp 3.4.4 -> 4.0.3)
# certifi>=2026.10.19: drops the compromised eMudhra emSign ECC Root CA - G3 (certifi #437/#439, Oct 2026)
RUN pip install --no-cache-dir fastmcp==4.0.3 supabase==2.31.0 "certifi>=2026.10.19"

# Copy all server code (modular structure)
COPY server.py .
COPY auth/ ./auth/
COPY utils/ ./utils/
COPY core/ ./core/
COPY enterprise/ ./enterprise/
COPY x/ ./x/

# Environment variables
ENV MCP_TRANSPORT=http
ENV HOST=0.0.0.0
ENV PORT=8000
# print() is block-buffered without a TTY: security log lines (rate limiter)
# reached Render minutes late or not at all (2026-09-30). Flush every line.
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["python", "server.py", "--http"]
