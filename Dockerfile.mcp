# Dockerfile for The Backroom MCP Server
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir fastmcp supabase

# Copy all server code (modular structure)
COPY server.py .
COPY auth/ ./auth/
COPY utils/ ./utils/
COPY core/ ./core/
COPY enterprise/ ./enterprise/
COPY x/ ./x/

# Environment variables
ENV MCP_TRANSPORT=http
ENV HOST=0.0.0.0
ENV PORT=8000

EXPOSE 8000

CMD ["python", "server.py", "--http"]
